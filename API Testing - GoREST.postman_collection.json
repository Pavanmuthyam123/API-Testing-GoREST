        {
          "name": "Get User Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User ID is present\", function () {\r",
                  "    pm.expect(jsonData.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User name is present\", function () {\r",
                  "    pm.expect(jsonData.name).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User email is present\", function () {\r",
                  "    pm.expect(jsonData.email).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Gender is present\", function () {\r",
                  "    pm.expect(jsonData.gender).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status is present\", function () {\r",
                  "    pm.expect(jsonData.status).to.exist;\r",
                  "});\r",
                  "\r",
                  "const expectjsonschema = {\r",
                  "    \"type\": \"object\",\r",
                  "    \"properties\": {\r",
                  "        \"id\": {\r",
                  "            \"type\": \"integer\"\r",
                  "        },\r",
                  "        \"name\": {\r",
                  "            \"type\": \"string\"\r",
                  "        },\r",
                  "        \"email\": {\r",
                  "            \"type\": \"string\"\r",
                  "        },\r",
                  "        \"gender\": {\r",
                  "            \"type\": \"string\"\r",
                  "        },\r",
                  "        \"status\": {\r",
                  "            \"type\": \"string\"\r",
                  "        }\r",
                  "    },\r",
                  "    \"required\": [\r",
                  "        \"id\",\r",
                  "        \"name\",\r",
                  "        \"email\",\r",
                  "        \"gender\",\r",
                  "        \"status\"\r",
                  "    ]\r",
                  "};\r",
                  "\r",
                  "pm.test(\"Response matches JSON Schema\", function () {\r",
                  "    pm.response.to.have.jsonSchema(expectjsonschema);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
